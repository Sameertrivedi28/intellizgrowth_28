<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="IntellizGrowth creates professional, responsive WordPress websites and WooCommerce stores that help businesses grow online.">
<meta name="theme-color" content="#650B50">
<title>IntellizGrowth | Websites That Help Businesses Grow</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
<style>
:root{--primary:#650B50;--deep:#3E0734;--ink:#29212A;--muted:#716773;--white:#fff;--soft:#F9F4F8;--line:#EDE3EB;--pink:#F0DCEB;--shadow:0 18px 50px rgba(62,7,52,.10);--radius:18px}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;scroll-padding-top:90px}
body{font-family:Inter,Arial,sans-serif;color:var(--ink);line-height:1.65;background:#fff;overflow-x:hidden}
a{text-decoration:none;color:inherit}
button{font:inherit}
img{max-width:100%;display:block}
.container{width:min(1160px,90%);margin-inline:auto}
.blue{color:var(--primary)}
.section{padding:92px 0}
.section-label{color:var(--primary);font-size:.76rem;font-weight:800;letter-spacing:1.7px;text-transform:uppercase}
.section-heading{text-align:center;max-width:720px;margin:0 auto 48px}
.section-heading h2,.about-copy h2,.faq-intro h2{font-size:clamp(2rem,4vw,2.8rem);line-height:1.16;letter-spacing:-1.5px;color:var(--deep);margin:12px 0}
.section-heading p,.about-copy p,.faq-intro p{color:var(--muted);font-size:.98rem}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:14px 21px;border-radius:9px;font-weight:700;font-size:.9rem;transition:.25s;border:1px solid transparent}
.btn-primary{background:var(--primary);color:white;box-shadow:0 9px 22px rgba(101,11,80,.18)}
.btn-primary:hover{background:var(--deep);transform:translateY(-3px)}
.btn-outline{border-color:#DCC9D8;color:var(--deep);background:white}
.btn-outline:hover{border-color:var(--primary);color:var(--primary);transform:translateY(-3px)}
/* Header */
.site-header{position:sticky;top:0;z-index:1000;background:rgba(255,255,255,.94);backdrop-filter:blur(14px);border-bottom:1px solid rgba(237,227,235,.9)}
.navbar{height:84px;display:flex;align-items:center;justify-content:space-between;gap:24px}
.brand img{width:245px;height:auto;max-height:68px;object-fit:contain}
.nav-links{display:flex;align-items:center;gap:28px}
.nav-links a{font-size:.87rem;font-weight:650;color:#443744;transition:.2s}
.nav-links a:hover{color:var(--primary)}
.nav-links .nav-cta{background:var(--primary);color:white;padding:11px 18px;border-radius:8px}
.nav-links .nav-cta:hover{background:var(--deep);color:white}
.menu-toggle{display:none;border:0;background:var(--soft);color:var(--deep);width:44px;height:44px;border-radius:9px;font-size:1.2rem;cursor:pointer}
/* Hero */
.hero{position:relative;overflow:hidden;padding:90px 0 100px;background:radial-gradient(circle at 80% 30%,#F0DCEB 0,transparent 32%),linear-gradient(135deg,#FFFCFE,#F9F4F8)}
.hero:before{content:"";position:absolute;width:420px;height:420px;border:1px solid rgba(101,11,80,.08);border-radius:50%;right:-190px;top:-150px}
.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:65px;position:relative}
.eyebrow{display:inline-flex;align-items:center;gap:9px;color:var(--primary);font-size:.74rem;font-weight:800;letter-spacing:1.5px;margin-bottom:22px}
.eyebrow i{font-size:.65rem}
.hero h1{font-size:clamp(2.65rem,5.5vw,4.45rem);line-height:1.06;letter-spacing:-3px;color:var(--deep);margin-bottom:23px}
.hero h1 span{color:var(--primary)}
.hero-copy>p{max-width:570px;color:var(--muted);font-size:1.04rem;margin-bottom:29px}
.hero-actions{display:flex;gap:13px;flex-wrap:wrap}
.hero-note{display:flex;align-items:center;gap:10px;margin-top:27px;color:var(--muted);font-size:.78rem;font-weight:600}
.hero-note i{width:23px;height:23px;display:grid;place-items:center;border-radius:50%;background:#E5F5EA;color:#21834B}
.hero-art{position:relative;min-width:0;padding:18px}
.art-halo{position:absolute;inset:10% 8%;background:#DAB9D2;filter:blur(65px);opacity:.55;border-radius:50%}
.browser{position:relative;background:#fff;border:1px solid #E9DDE7;border-radius:16px;overflow:hidden;box-shadow:0 28px 75px rgba(62,7,52,.17);transform:rotate(-1.5deg)}
.browser-bar{height:43px;background:#F7F3F6;border-bottom:1px solid #EEE5EC;display:flex;align-items:center;gap:7px;padding:0 15px}
.browser-bar i{font-size:8px;color:#C9B6C5}
.browser-url{margin-left:17px;background:#fff;border-radius:5px;padding:3px 40px;color:#9B8D99;font-size:.6rem}
.site-mock{padding:19px}
.mock-nav{display:flex;justify-content:space-between;align-items:center;font-size:.6rem;color:var(--deep);font-weight:800}
.mock-nav small{color:#887987;font-weight:600;word-spacing:10px}
.mock-banner{margin-top:18px;border-radius:10px;padding:35px 24px;background:linear-gradient(120deg,#3E0734,#86156C);color:white;min-height:205px}
.mock-banner small{font-size:.55rem;letter-spacing:1.6px;color:#F1D9EA}
.mock-banner h3{font-size:1.9rem;line-height:1.12;margin:12px 0}
.mock-banner p{font-size:.66rem;color:#F1D9EA}
.mock-button{margin-top:17px;width:95px;height:23px;background:#fff;border-radius:5px}
.mock-features{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;padding-top:17px}
.mock-feature{border:1px solid #F0E8EF;border-radius:8px;padding:12px 8px;text-align:center}
.mock-feature i{color:var(--primary);font-size:1rem}
.mock-feature b{display:block;font-size:.65rem;color:var(--deep);margin-top:5px}
.mock-feature small{font-size:.53rem;color:#897C88}
.float-chip{position:absolute;background:white;box-shadow:var(--shadow);border:1px solid #F0E7EF;border-radius:10px;padding:11px 14px;font-size:.72rem;font-weight:750;color:var(--deep)}
.float-chip i{color:var(--primary);margin-right:7px}
.chip-top{right:-2%;top:8%}.chip-bottom{left:-3%;bottom:8%}
/* proof strip */
.proof-strip{border-bottom:1px solid var(--line);background:#fff;padding:24px 0}
.proof-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.proof-item{display:flex;align-items:center;justify-content:center;gap:11px;font-size:.82rem;font-weight:700;color:#514452}
.proof-item i{font-size:1.2rem;color:var(--primary)}
/* About */
.about-grid{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:75px}
.about-visual{min-height:350px;background:linear-gradient(140deg,#F7EAF3,#EBD6E7);border-radius:22px;display:grid;place-items:center;position:relative;overflow:hidden}
.about-visual:before,.about-visual:after{content:"";position:absolute;border:1px solid rgba(101,11,80,.15);border-radius:50%;width:280px;height:280px}
.about-visual:after{width:360px;height:360px}
.about-card{position:relative;z-index:1;background:#fff;border-radius:16px;padding:38px 30px;text-align:center;width:min(310px,78%);box-shadow:var(--shadow)}
.about-card i{font-size:3.5rem;color:var(--primary);margin-bottom:14px}
.about-card h3{color:var(--deep);font-size:1.2rem}
.about-card p{font-size:.8rem;color:var(--muted);margin-top:7px}
.about-stamp{position:absolute;bottom:20px;right:18px;z-index:2;background:var(--primary);color:white;padding:10px 14px;border-radius:8px;font-size:.7rem;font-weight:700}
.about-copy p{margin:0 0 16px}
.text-link{display:inline-flex;gap:9px;align-items:center;color:var(--primary);font-size:.88rem;font-weight:750;margin-top:8px}
/* services */
.services,.portfolio{background:#FCF9FB}
.services-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.service-card{padding:28px;background:white;border:1px solid var(--line);border-radius:14px;transition:.25s}
.service-card:hover{transform:translateY(-6px);box-shadow:var(--shadow);border-color:#D8B9D1}
.service-icon{width:52px;height:52px;border-radius:12px;background:var(--soft);color:var(--primary);display:grid;place-items:center;font-size:1.35rem;margin-bottom:20px}
.service-card h3{font-size:1.05rem;color:var(--deep);margin-bottom:9px}
.service-card p{font-size:.84rem;color:var(--muted);min-height:66px;margin-bottom:15px}
.service-card a{font-size:.8rem;font-weight:750;color:var(--primary)}
/* Why */
.why-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.why-card{text-align:center;padding:25px 16px;border:1px solid var(--line);border-radius:13px}
.why-card i{font-size:1.8rem;color:var(--primary);margin-bottom:14px}
.why-card h3{font-size:.95rem;color:var(--deep);margin-bottom:7px}
.why-card p{font-size:.78rem;color:var(--muted)}
/* Portfolio */
.portfolio-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.project-card{background:white;border:1px solid var(--line);border-radius:14px;overflow:hidden;transition:.25s}
.project-card:hover{transform:translateY(-5px);box-shadow:var(--shadow)}
.project-art{height:220px;padding:24px;display:grid;place-items:center}
.project-art.one{background:#F1E4EF}.project-art.two{background:#EEE7F0}.project-art.three{background:#F7E9F0}
.project-screen{width:84%;background:#fff;border-radius:8px;padding:23px;box-shadow:0 10px 30px rgba(62,7,52,.10)}
.project-screen small{font-size:.55rem;letter-spacing:1px;color:var(--primary);font-weight:800}
.project-screen h3{font-size:1.35rem;line-height:1.15;color:var(--deep);margin:12px 0}
.project-screen span{display:block;width:62px;height:17px;background:var(--primary);border-radius:4px}
.project-info{padding:21px}
.project-info>small{font-size:.65rem;color:var(--primary);font-weight:800;letter-spacing:1px}
.project-info h3{color:var(--deep);font-size:1rem;margin:6px 0 10px}
.project-info a{color:var(--primary);font-size:.77rem;font-weight:750}
/* Process */
.process-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:17px}
.process-card{position:relative;border:1px solid var(--line);border-radius:13px;padding:25px 20px}
.process-number{position:absolute;right:17px;top:10px;color:#EADDE7;font-size:2.2rem;font-weight:800}
.process-card i{font-size:1.5rem;color:var(--primary);margin:18px 0}
.process-card h3{font-size:1rem;color:var(--deep);margin-bottom:7px}
.process-card p{font-size:.79rem;color:var(--muted)}
/* CTA */
.cta{padding:82px 0;background:radial-gradient(circle at 80% 15%,#8D347A 0,transparent 30%),linear-gradient(120deg,#3E0734,#650B50);color:#fff;text-align:center}
.cta-inner{max-width:760px;margin:auto}
.cta-inner>span{font-size:.7rem;letter-spacing:1.8px;font-weight:800;color:#F0D5E9}
.cta h2{font-size:clamp(2rem,4vw,2.8rem);line-height:1.15;margin:15px 0}
.cta p{font-size:.9rem;color:#F0DCEB;max-width:620px;margin:0 auto 25px}
.btn-white{background:white;color:var(--primary)}
.btn-white:hover{background:#F8EAF4;transform:translateY(-3px)}
/* FAQ */
.faq-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:70px;align-items:start}
.faq-intro h2{margin-bottom:14px}
.faq-list details{border-bottom:1px solid var(--line);padding:18px 0}
.faq-list summary{list-style:none;display:flex;justify-content:space-between;gap:15px;cursor:pointer;color:var(--deep);font-size:.9rem;font-weight:700}
.faq-list summary::-webkit-details-marker{display:none}
.faq-list summary:after{content:"+";font-size:1.25rem;color:var(--primary)}
.faq-list details[open] summary:after{content:"−"}
.faq-list details p{font-size:.83rem;color:var(--muted);padding:12px 25px 0 0}
/* Footer */
.footer{background:#2D0828;color:white;padding:65px 0 0}
.footer-grid{display:grid;grid-template-columns:1.5fr 1fr 1.25fr 1fr;gap:35px;padding-bottom:45px}
.footer-logo{display:inline-block;background:#fff;border-radius:8px;padding:5px 9px}
.footer-logo img{width:205px;height:auto}
.footer-brand p{max-width:285px;font-size:.8rem;color:#D8C6D5;margin:18px 0}
.socials{display:flex;gap:9px}
.socials a{width:36px;height:36px;border-radius:8px;background:#4A1C43;color:#fff;display:grid;place-items:center;transition:.2s}
.socials a:hover{background:var(--primary)}
.footer-col h4{font-size:.9rem;margin-bottom:17px}
.footer-col a{display:block;font-size:.78rem;color:#D8C6D5;margin:11px 0}
.footer-col a:hover{color:#fff}
.copyright{border-top:1px solid #58334F;padding:19px 0;display:flex;justify-content:space-between;gap:15px;color:#D8C6D5;font-size:.7rem}
.back-top{position:fixed;right:22px;bottom:22px;width:44px;height:44px;border:0;border-radius:10px;background:var(--primary);color:white;box-shadow:var(--shadow);cursor:pointer;opacity:0;visibility:hidden;transform:translateY(8px);transition:.25s;z-index:500}
.back-top.show{opacity:1;visibility:visible;transform:translateY(0)}
/* Responsive */
@media(max-width:950px){
 .nav-links{gap:17px}.nav-links a{font-size:.8rem}.brand img{width:210px}
 .hero-grid{gap:30px}.hero h1{font-size:3.35rem}
 .services-grid{grid-template-columns:repeat(2,1fr)}
 .why-grid{grid-template-columns:repeat(2,1fr)}
 .footer-grid{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:720px){
 .navbar{height:72px}.brand img{width:195px;max-height:60px}
 .menu-toggle{display:grid;place-items:center}
 .nav-links{position:absolute;top:72px;left:0;right:0;background:white;padding:18px 5% 24px;display:none;flex-direction:column;align-items:stretch;gap:0;border-bottom:1px solid var(--line);box-shadow:0 15px 25px rgba(62,7,52,.08)}
 .nav-links.open{display:flex}
 .nav-links a{padding:12px 4px;font-size:.9rem}
 .nav-links .nav-cta{text-align:center;margin-top:8px;padding:12px}
 .hero{padding:65px 0 75px}.hero-grid{grid-template-columns:1fr;gap:48px}
 .hero h1{font-size:clamp(2.6rem,10vw,3.6rem);letter-spacing:-2px}
 .hero-copy>p{font-size:.94rem}.hero-art{padding:12px 8px}
 .chip-top{right:-1%}.chip-bottom{left:-1%}
 .proof-grid{grid-template-columns:repeat(2,1fr);gap:18px 8px}
 .proof-item{justify-content:flex-start;font-size:.72rem}
 .section{padding:70px 0}
 .about-grid{grid-template-columns:1fr;gap:38px}
 .about-visual{min-height:300px}
 .services-grid,.portfolio-grid{grid-template-columns:1fr}
 .service-card p{min-height:0}
 .process-grid{grid-template-columns:repeat(2,1fr)}
 .faq-grid{grid-template-columns:1fr;gap:28px}
 .footer-grid{grid-template-columns:repeat(2,1fr);gap:30px 20px}
}
@media(max-width:420px){
 .container{width:90%}
 .hero-actions{flex-direction:column}
 .hero-actions .btn{width:100%}
 .mock-banner{padding:27px 17px}.mock-banner h3{font-size:1.55rem}
 .browser-url{padding-inline:15px}
 .float-chip{font-size:.62rem;padding:9px}
 .why-grid{gap:10px}.why-card{padding:20px 10px}
 .process-grid{gap:10px}.process-card{padding:16px 13px}
 .footer-grid{grid-template-columns:1fr}
 .copyright{flex-direction:column;text-align:center}
}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{animation-duration:.01ms!important;transition-duration:.01ms!important}}
</style>
</head>
